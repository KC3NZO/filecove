{
  "name": "filecove",
  "version": "0.1.0",
  "description": "A file manager and media manager for React: bring your own backend through a small adapter.",
  "keywords": [
    "react",
    "file-manager",
    "file-explorer",
    "file-browser",
    "media-library",
    "media-manager",
    "media-picker",
    "uploader"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KC3NZO/filecove.git"
  },
  "homepage": "https://github.com/KC3NZO/filecove/tree/main/docs#readme",
  "bugs": {
    "url": "https://github.com/KC3NZO/filecove/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/filled": {
      "types": "./dist/icon-sets/filled.d.ts",
      "import": "./dist/icon-sets/filled.js"
    },
    "./icons/outlined": {
      "types": "./dist/icon-sets/outlined.d.ts",
      "import": "./dist/icon-sets/outlined.js"
    },
    "./icons/rounded": {
      "types": "./dist/icon-sets/rounded.d.ts",
      "import": "./dist/icon-sets/rounded.js"
    },
    "./icons/sharp": {
      "types": "./dist/icon-sets/sharp.d.ts",
      "import": "./dist/icon-sets/sharp.js"
    },
    "./icons/two-tone": {
      "types": "./dist/icon-sets/two-tone.d.ts",
      "import": "./dist/icon-sets/two-tone.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json && bun scripts/clean-declarations.ts",
    "prepublishOnly": "bun run build:lib"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@react-symbols/icons": "^1.4.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
